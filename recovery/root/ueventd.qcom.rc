firmware_directories /vendor/firmware/ /firmware/image/ /vendor/firmware_mnt/image/ /mnt/vendor/persist/
/dev/qseecom               0660 root system
/dev/ion                   0664 root system
/dev/kgsl-3d0              0660 root graphics
/dev/dri/*                 0660 root graphics
/dev/input/*               0660 root input
/dev/graphics/*            0660 root graphics
/sys/class/backlight/panel0-backlight brightness 0660 root graphics
