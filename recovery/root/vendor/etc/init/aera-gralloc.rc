# SPDX-License-Identifier: Apache-2.0
service aera-gralloc /system/bin/aera-vendor-allocator
    class hal
    user root
    group root graphics drmrpc
    seclabel u:r:recovery:s0
    interface android.hardware.graphics.allocator@3.0::IAllocator default
    interface android.hardware.graphics.allocator@4.0::IAllocator default
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/egl
